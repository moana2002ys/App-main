# 필요한 환경변수 "목록" 파일 (실제 값 없음 — 이 파일은 git에 올려도 안전).
# 각자 로컬에서:  cp .env.example .env  → .env에 실제 값 채우기.
# .env 는 .gitignore로 막혀 있어 절대 커밋되지 않습니다 (public 레포 보안).

# ── 필수 ─────────────────────────────
# Postgres 연결 문자열 (Replit이 주던 DB → 로컬은 각자 준비: Neon/Supabase 무료 or 로컬 Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# OpenAI API 키 (LLM 미션 생성용)
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── 선택 (기본값 있음) ─────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── Replit 전용 (로컬 개발엔 보통 불필요) ──
# BASE_PATH=
# REPL_ID=
