# 필요한 환경변수 "목록" 파일 (실제 값 없음 — 이 파일은 git에 올려도 안전).
# 각자 로컬에서:  cp .env.example .env  → .env에 실제 값 채우기.
# .env 는 .gitignore로 막혀 있어 절대 커밋되지 않습니다 (public 레포 보안).

# ── 필수 ─────────────────────────────
# Postgres 연결 문자열.
# 로컬 개발은 설치 없이 내장 DB를 쓰면 된다:
#   1) pnpm --filter @workspace/scripts dev-db   (켜둔 채로)
#   2) pnpm --filter @workspace/db push          (최초 1회, 테이블 생성)
#   3) 아래 값 그대로 사용:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5502/jogak
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5502/jogak
# OpenAI API 키 (사진 인증·LLM 기능용).
# 로컬에서 그 기능을 안 쓸 거면 아무 값이나 넣어도 서버는 뜬다 (비워두면 부팅 실패).
AI_INTEGRATIONS_OPENAI_API_KEY=sk-local-dev-placeholder

# ── 선택 (기본값 있음) ─────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── Replit 전용 (로컬 개발엔 보통 불필요) ──
# BASE_PATH=
# REPL_ID=
